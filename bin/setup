#!/usr/bin/env ruby
# frozen_string_literal: true

# Creates the development database, loads the schema and seeds it.
#
#   bin/setup                 sqlite, 20 users
#   DB=postgres bin/setup     PostgreSQL
#   SEED_USERS=500 bin/setup

require "bundler/setup"
require_relative "../dev/boot"

puts "==> #{Dev.describe}"
Dev.reset!
Dev.seed!

puts <<~NEXT

  Ready. Open the console:

    #{"DB=#{Dev::ADAPTER} " unless Dev::ADAPTER == "sqlite"}bin/console
NEXT
